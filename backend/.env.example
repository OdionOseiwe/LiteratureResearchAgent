# Server
PORT=5001
FRONTEND_URL=http://localhost:5173

# Database
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/research-agent?retryWrites=true&w=majority

# LLM provider (OpenAI-compatible). For FREE Gemini via Google AI Studio:
#   get a key at https://aistudio.google.com/apikey then use:
#   OPENAI_API_KEY=<your Gemini key>
#   OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   OPENAI_MODEL=gemini-2.5-flash   (or any free-tier model your account lists)
# For OpenAI: set OPENAI_BASE_URL=https://api.openai.com/v1/ (or leave default) with an OpenAI key.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# Fast/cheap model for extraction, verification and classification work
OPENAI_MODEL=gemini-2.5-flash
# Stronger model for synthesis & complex reasoning (may be the same model)
OPENAI_MODEL_HEAVY=gemini-2.5-flash

# Web search - free tier available at https://tavily.com (1,000 credits/month)
TAVILY_API_KEY=

# Optional advanced overrides (leave unset for defaults)
# TAVILY_BASE_URL=https://api.tavily.com
# JINA_READER_BASE_URL=https://r.jina.ai

# PDF storage (relative to backend/ or absolute)
PDF_STORAGE_PATH=./storage

# Cost / safety controls
MAX_SOURCES_PER_RUN=18
MAX_PAGE_CHARS=12000
MAX_RESEARCH_ROUNDS=2
SEARCH_RESULTS_PER_QUERY=6
